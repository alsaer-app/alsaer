<?xml version="1.0" encoding="utf-8"?>
<!-- النسخ الاحتياطي التلقائي: نستبعد كل ما هو حساس أو شخصي.
     بيانات التطبيق الأساسية (العادات والتوبة ورمز القفل) تعيش في WebView localStorage
     داخل app_webview فتُستبعد كاملة، وتبقى النسخة المشفرة اليدوية هي الطريق الآمن. -->
<full-backup-content>
    <exclude domain="file" path="app_webview" />
    <exclude domain="file" path="Web Storage" />
    <exclude domain="database" path="webview.db" />
    <exclude domain="database" path="webviewCache.db" />
    <exclude domain="sharedpref" path="alsaer_notif.xml" />
    <exclude domain="sharedpref" path="alsaer_float.xml" />
    <exclude domain="sharedpref" path="CapacitorStorage.xml" />
</full-backup-content>

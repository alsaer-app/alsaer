<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">
    <ImageView
        android:id="@+id/wg_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />
    <LinearLayout
        android:id="@+id/wg_in"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="10dp">
        <TextView android:id="@+id/wg_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E8C873" android:textSize="13sp" android:maxLines="1" android:text="السائر إلى الله" />
        <TextView android:id="@+id/wg_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" android:maxLines="1" android:text="--:--" />
        <LinearLayout android:id="@+id/wg_row" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
            <TextView android:id="@+id/wg_lbl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#9FB3AE" android:textSize="12sp" android:text="متبقٍ " />
            <Chronometer android:id="@+id/wg_left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#9FB3AE" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/wg_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#9FB3AE" android:textSize="11sp" android:maxLines="1" />
        <LinearLayout android:id="@+id/wg_pr" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp" android:visibility="gone">
        <TextView android:id="@+id/wg_p1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textColor="#9FB3AE" android:textSize="10sp" android:maxLines="2"/>
        <TextView android:id="@+id/wg_p2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textColor="#9FB3AE" android:textSize="10sp" android:maxLines="2"/>
        <TextView android:id="@+id/wg_p3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textColor="#9FB3AE" android:textSize="10sp" android:maxLines="2"/>
        <TextView android:id="@+id/wg_p4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textColor="#9FB3AE" android:textSize="10sp" android:maxLines="2"/>
        <TextView android:id="@+id/wg_p5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textColor="#9FB3AE" android:textSize="10sp" android:maxLines="2"/>
        </LinearLayout>
        <TextView android:id="@+id/wg_book" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#E8C873" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
